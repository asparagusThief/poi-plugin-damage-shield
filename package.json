{
  "name": "poi-plugin-damage-shield",
  "version": "0.1.4",
  "description": "在舰船中破／大破立绘动画播放期间遮挡整个游戏画面。",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "asparagusThief",
    "url": "https://github.com/asparagusThief"
  },
  "homepage": "https://github.com/asparagusThief/poi-plugin-damage-shield#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asparagusThief/poi-plugin-damage-shield.git"
  },
  "bugs": {
    "url": "https://github.com/asparagusThief/poi-plugin-damage-shield/issues"
  },
  "files": [
    "index.js",
    "src",
    "i18n",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check src/game-shield.js && node --check src/controller.js && node --check src/i18n.js",
    "pack:local": "npm pack --ignore-scripts --cache .npm-cache --pack-destination dist"
  },
  "poiPlugin": {
    "name": "Damage Animation Shield",
    "id": "damage-shield",
    "description": "Cover the game screen during damage cut-in animations",
    "i18nDir": "i18n",
    "icon": "fa/shield",
    "earliestCompatibleMain": "12.0.1",
    "priority": 100
  },
  "devDependencies": {
    "i18next": "^26.0.8"
  }
}
